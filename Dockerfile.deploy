FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci && npm cache clean --force

COPY tsconfig.json ./
COPY src ./src

ENV NODE_ENV=production
ENV TS_NODE_TRANSPILE_ONLY=true

USER node

EXPOSE 5000

CMD ["node", "-r", "ts-node/register/transpile-only", "-r", "tsconfig-paths/register", "src/shared/http/server.ts"]
